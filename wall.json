   "lines": [
    "TARGETS = {",
    "    \"youtube\": (\"url\", \"https://www.youtube.com\", \"YouTube\"),",
    "    \"\u092f\u0942\u091f\u094d\u092f\u0942\u092c\": (\"url\", \"https://www.youtube.com\", \"YouTube\"),",
    "    \"chrome\": (\"app\", \"chrome\", \"Chrome\"),",
    "    \"\u0915\u094d\u0930\u094b\u092e\": (\"app\", \"chrome\", \"Chrome\"),",
    "    \"google\": (\"url\", \"https://www.google.com\", \"Google\"),",
    "    \"\u0917\u0942\u0917\u0932\": (\"url\", \"https://www.google.com\", \"Google\"),",
    "    \"spotify\": (\"app\", \"spotify\", \"Spotify\"),",
    "    \"whatsapp\": (\"app\", \"whatsapp\", \"WhatsApp\"),",
    "    \"\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a\": (\"app\", \"whatsapp\", \"WhatsApp\"),",
    "    \"vs code\": (\"app\", \"code\", \"VS Code\"),",
    "    \"calculator\": (\"app\", \"calc\", \"Calculator\"),",
    "    \"\u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f\u0930\": (\"app\", \"calc\", \"Calculator\"),",
    "    \"notepad\": (\"app\", \"notepad\", \"Notepad\"),",
    "}",
    "def _tokens(text):",
    "    # Sirf akshar/ank/nishan (matra) rakho \u2014 Devanagari ki matrayein \\w me",
    "    # nahi aati, isliye category se chhanta hai, regex se nahi.",
    "    out = []",
    "    for ch in text.lower():",
    "        if ch.isspace() or unicodedata.category(ch)[0] in \"LNM\":",
    "            out.append(ch)",
    "        else:",
    "            out.append(\" \")",
    "    return \"\".join(out).split()",
    "",
    "",
    "def _find(tokens, words):",
    "    \"\"\"words wale kisi token ka pehla index, warna -1.\"\"\"",
    "    for i, tok in enumerate(tokens):",
    "        if tok in words:",
    "            return i",
    "    return -1",
    "",
    ""
   ]
  }
