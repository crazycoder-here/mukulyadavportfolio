    "import json, os, re, subprocess, sys, time",
    "from pathlib import Path",
    "",
    "def _load_env():",
    "    for d in (Path(__file__).parent, Path.cwd()):",
    "        f = d / \".env\"",
    "        if f.exists():",
    "            for line in f.read_text(encoding=\"utf-8\", errors=\"ignore\").splitlines():",
    "                m = re.match(r\"\\s*([A-Z_]+)\\s*=\\s*(.*)\\s*$\", line)",
    "                if m and m.group(1) not in os.environ:",
    "                    os.environ[m.group(1)] = m.group(2).strip().strip('\"').strip(\"'\")",
    "            break",
    "_load_env()",
    "",
    "DATA = Path(os.environ.get(\"ORBIT_DATA\", r\"C:\\Users\\mukul\\ORBIT_Data\"))",
    "STATE = DATA / \"phone_bridge_state.json\"",
    "PIDF = DATA / \"phone_bridge.pid\"",
    "LOGF = DATA / \"phone_bridge_daemon.log\"",
    "DOMAIN = os.environ.get(\"PHONE_SIP_DOMAIN\", \"sip.linphone.org\")",
    "USER = os.environ.get(\"PHONE_SIP_USER\", \"\")",
    "PASS = os.environ.get(\"PHONE_SIP_PASSWORD\", \"\")",
    "OWNER = os.environ.get(\"PHONE_OWNER_USER\", \"\")",
    "NARROW = {\"pcmu\", \"pcma\", \"g729\"}    # 8kHz \u2014 ye band",
    "",
    "def write_state(**kw):",
    "    kw[\"updated_at\"] = time.strftime(\"%Y-%m-%dT%H:%M:%S\")",
    "    try:",
    "        DATA.mkdir(parents=True, exist_ok=True)",
    "        tmp = STATE.with_suffix(\".tmp\")",
    "        tmp.write_text(json.dumps(kw, indent=1), encoding=\"utf-8\")",
    "        tmp.replace(STATE)",
    "    except OSError:",
    "        pass",
    "",
    "def find_daemon():",
    "    \"\"\"linphoned.exe / linphone-daemon.exe dhoondo. None = nahi mila.\"\"\"",
    "    env = os.environ.get(\"LINPHONED_PATH\", \"\")",
    "    cands = [Path(env)] if env else []",
    "    for base in (r\"C:\\Program Files\\Linphone\\bin\", r\"C:\\Program Files (x86)\\Linphone\\bin\",",
    "                 r\"C:\\Program Files\\Linphone\", r\"C:\\Program Files (x86)\\Linphone\"):",
    "        for name in (\"linphoned.exe\", \"linphone-daemon.exe\"):",
    "            cands.append(Path(base) / name)",
    "    for c in cands:",
    "        if c and c.exists():",
    "            return c",
    "    return None",
    "",
    "def find_sh(daemon):",
    "    if daemon:",
    "        sh = daemon.parent / \"linphonecsh.exe\"",
    "        if sh.exists():",
    "            return sh",
    "    return None",
    "",
    "        return Path(env)",
    "    local = os.environ.get(\"LOCALAPPDATA\", \"\")",
    "    p = Path(local) / \"linphone\" / \"linphonerc\" if local else None",
    "    if p and p.exists():",
    "        return p",
    "    return p or Path.home() / \".linphonerc\"",
    "",
    "# ---------- linphonerc sampadan (shudh string kaam; selftest yahi jaanchta hai) ----------",
    "",
    "def _section(text, name):",
